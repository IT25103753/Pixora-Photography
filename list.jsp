<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<c:set var="pageTitle" value="Bookings"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<section class="page-hero compact"><div class="container d-flex justify-content-between align-items-end"><div><span class="eyebrow">BOOKING MANAGEMENT</span><h1>Bookings</h1><p>Track requests, decisions, event status and cancellations.</p></div><c:if test="${sessionScope.authUser.roleCode == 'CUSTOMER'}"><a class="btn btn-warning" href="${pageContext.request.contextPath}/photographers">New booking</a></c:if></div></section>
<div class="container py-5"><div class="panel-card"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Reference</th><th>Event</th><th>Photographer</th><th>Date</th><th>Amount</th><th>Status</th><th></th></tr></thead><tbody>
<c:forEach items="${bookings}" var="b"><tr><td><strong>${b.bookingRef}</strong></td><td><c:out value="${b.eventType}"/></td><td><c:out value="${b.photographerName}"/></td><td>${b.eventDate}<br><small>${b.startTime}–${b.endTime}</small></td><td>LKR ${b.totalAmount}</td><td><span class="status-badge status-${b.status}">${b.status}</span></td><td><a class="btn btn-sm btn-outline-dark" href="${pageContext.request.contextPath}/bookings?view=detail&id=${b.bookingId}">Open</a></td></tr></c:forEach>
<c:if test="${empty bookings}"><tr><td colspan="7"><div class="empty-state">No bookings to show.</div></td></tr></c:if></tbody></table></div></div></div>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
