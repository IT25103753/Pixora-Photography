<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<c:set var="pageTitle" value="Submit complaint"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<div class="container py-5 narrow"><div class="panel-card"><span class="eyebrow">SUPPORT REQUEST</span><h2 class="mt-2">Submit a complaint</h2><form method="post" enctype="multipart/form-data" action="${pageContext.request.contextPath}/complaints" class="row g-3"><input type="hidden" name="action" value="create"><div class="col-12"><label class="form-label">Related booking</label><select class="form-select" name="bookingId" required><option value="">Choose booking</option><c:forEach items="${bookings}" var="b"><c:if test="${b.status != 'PENDING'}"><option value="${b.bookingId}">${b.bookingRef} — ${b.eventType}</option></c:if></c:forEach></select></div><div class="col-md-6"><label class="form-label">Category</label><select class="form-select" name="category"><option>Booking</option><option>Payment</option><option>Photo Delivery</option><option>Photographer Conduct</option><option>Other</option></select></div><div class="col-md-6"><label class="form-label">Evidence (optional)</label><input class="form-control" type="file" name="evidence" accept=".jpg,.jpeg,.png,.webp,.pdf"></div><div class="col-12"><label class="form-label">Describe the issue</label><textarea class="form-control" rows="6" name="description" required></textarea></div><div class="col-12"><button class="btn btn-warning">Submit complaint</button></div></form></div></div>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
