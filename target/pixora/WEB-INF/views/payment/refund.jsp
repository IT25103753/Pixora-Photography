<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<c:set var="pageTitle" value="Refund request"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<div class="container py-5 narrow"><div class="panel-card"><span class="eyebrow">REFUND REQUEST</span><h2 class="mt-2">${payment.paymentRef}</h2><p class="text-muted">Demo policy: the related booking must already be cancelled. Authorized staff reviews every request.</p><form method="post" action="${pageContext.request.contextPath}/payments" class="row g-3"><input type="hidden" name="action" value="refund-request"><input type="hidden" name="paymentId" value="${payment.paymentId}"><div class="col-12"><label class="form-label">Refund amount</label><input class="form-control" type="number" step=".01" min=".01" max="${payment.amount}" name="amount" value="${payment.amount}" required></div><div class="col-12"><label class="form-label">Reason</label><textarea class="form-control" name="reason" rows="4" required></textarea></div><div class="col-12"><button class="btn btn-warning">Submit for review</button></div></form></div></div>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
