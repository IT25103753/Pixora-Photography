<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<c:set var="pageTitle" value="Complaints & Feedback"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<section class="page-hero compact"><div class="container d-flex justify-content-between align-items-end"><div><span class="eyebrow">CUSTOMER RELATIONS</span><h1>Complaints & feedback</h1><p>Trackable support with complete communication history.</p></div><c:if test="${sessionScope.authUser.roleCode == 'CUSTOMER'}"><a class="btn btn-warning" href="${pageContext.request.contextPath}/complaints?view=new">Submit complaint</a></c:if></div></section>
<div class="container py-5"><div class="panel-card"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Reference</th><th>Category</th><th>Priority</th><th>Status</th><th>Created</th><th></th></tr></thead><tbody><c:forEach items="${complaints}" var="c"><tr><td><strong>${c.complaintRef}</strong></td><td><c:out value="${c.category}"/></td><td>${c.priority}</td><td><span class="status-badge">${c.status}</span></td><td>${c.createdAt}</td><td><a class="btn btn-sm btn-outline-dark" href="${pageContext.request.contextPath}/complaints?view=detail&id=${c.complaintId}">Open</a></td></tr></c:forEach><c:if test="${empty complaints}"><tr><td colspan="6"><div class="empty-state">No complaints found.</div></td></tr></c:if></tbody></table></div></div>
<c:if test="${sessionScope.authUser.roleCode == 'SYSTEM_ADMIN'}"><div class="panel-card mt-4"><h4>Review moderation</h4><div class="table-responsive"><table class="table"><thead><tr><th>Rating</th><th>Comment</th><th>Visible</th><th></th></tr></thead><tbody><c:forEach items="${reviews}" var="r"><tr><td>${r.rating}/5</td><td><c:out value="${r.comment}"/></td><td>${r.visible}</td><td><form method="post" action="${pageContext.request.contextPath}/complaints"><input type="hidden" name="action" value="review-moderate"><input type="hidden" name="reviewId" value="${r.reviewId}"><button class="btn btn-sm btn-outline-dark" name="decision" value="${r.visible ? 'HIDE' : 'SHOW'}">${r.visible ? 'Hide' : 'Show'}</button></form></td></tr></c:forEach></tbody></table></div></div></c:if>
</div>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
