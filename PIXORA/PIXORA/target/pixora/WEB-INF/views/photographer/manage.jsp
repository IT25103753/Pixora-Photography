<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<c:set var="pageTitle" value="Photographer Studio"/>
<jsp:include page="/WEB-INF/views/common/header.jsp"/>
<section class="page-hero compact"><div class="container"><span class="eyebrow">PHOTOGRAPHER STUDIO</span><h1>Profile, portfolio, packages & availability</h1><p>Approval status: <span class="badge text-bg-warning">${profile.approvalStatus}</span></p></div></section>
<div class="container py-5">
<ul class="nav nav-pills pixora-tabs mb-4" role="tablist"><li class="nav-item"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#profileTab">Profile</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#portfolioTab">Portfolio</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#packageTab">Packages</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#availabilityTab">Availability</button></li></ul>
<div class="tab-content">
<div class="tab-pane fade show active" id="profileTab"><div class="panel-card"><form method="post" enctype="multipart/form-data" action="${pageContext.request.contextPath}/photographer/manage" class="row g-3"><input type="hidden" name="action" value="profile">
<div class="col-md-6"><label class="form-label">Specialty</label><input class="form-control" name="specialty" value="<c:out value='${profile.specialty}'/>" placeholder="Weddings, Portraits..."></div>
<div class="col-md-6"><label class="form-label">Location</label><input class="form-control" name="location" value="<c:out value='${profile.location}'/>"></div>
<div class="col-12"><label class="form-label">Professional bio</label><textarea class="form-control" rows="5" name="bio"><c:out value="${profile.bio}"/></textarea></div>
<div class="col-12"><label class="form-label">Profile image</label><input class="form-control" type="file" name="profileImage" accept=".jpg,.jpeg,.png,.webp"></div>
<div class="col-12"><button class="btn btn-warning">Save profile</button></div></form></div></div>
<div class="tab-pane fade" id="portfolioTab"><div class="panel-card mb-4"><h4>Add portfolio item</h4><form method="post" enctype="multipart/form-data" action="${pageContext.request.contextPath}/photographer/manage" class="row g-3"><input type="hidden" name="action" value="portfolio-add"><div class="col-md-4"><input class="form-control" name="title" placeholder="Title" required></div><div class="col-md-4"><input class="form-control" name="description" placeholder="Description"></div><div class="col-md-4"><input class="form-control" type="file" name="image" accept=".jpg,.jpeg,.png,.webp" required></div><div class="col-12"><button class="btn btn-dark">Add item</button></div></form></div>
<div class="row g-3"><c:forEach items="${portfolio}" var="i"><div class="col-md-4"><div class="panel-card h-100"><form method="post" action="${pageContext.request.contextPath}/photographer/manage"><input type="hidden" name="action" value="portfolio-update"><input type="hidden" name="id" value="${i.portfolioId}"><input class="form-control mb-2" name="title" value="<c:out value='${i.title}'/>" required><textarea class="form-control mb-2" name="description" rows="2"><c:out value="${i.description}"/></textarea><button class="btn btn-sm btn-dark">Save</button></form><form method="post" class="mt-2" action="${pageContext.request.contextPath}/photographer/manage" data-confirm="Remove this portfolio item?"><input type="hidden" name="action" value="portfolio-delete"><input type="hidden" name="id" value="${i.portfolioId}"><button class="btn btn-sm btn-outline-danger">Remove</button></form></div></div></c:forEach></div></div>
<div class="tab-pane fade" id="packageTab"><div class="panel-card mb-4"><h4>${empty editPackage ? 'Create package' : 'Edit package'}</h4><form method="post" action="${pageContext.request.contextPath}/photographer/manage" class="row g-3"><input type="hidden" name="action" value="package-save"><input type="hidden" name="id" value="${empty editPackage ? 0 : editPackage.packageId}"><div class="col-md-3"><input class="form-control" name="name" value="<c:out value='${editPackage.name}'/>" placeholder="Package name" required></div><div class="col-md-3"><input class="form-control" type="number" step=".01" min="0" name="price" value="${editPackage.price}" placeholder="Price LKR" required></div><div class="col-md-2"><input class="form-control" type="number" min="1" name="durationHours" value="${editPackage.durationHours}" placeholder="Hours" required></div><div class="col-md-4"><input class="form-control" name="description" value="<c:out value='${editPackage.description}'/>" placeholder="Description"></div><div class="col-12"><button class="btn btn-dark">Save package</button><c:if test="${not empty editPackage}"> <a class="btn btn-outline-secondary" href="${pageContext.request.contextPath}/photographer/manage">Cancel edit</a></c:if></div></form></div>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Name</th><th>Price</th><th>Duration</th><th>Status</th><th></th></tr></thead><tbody><c:forEach items="${packages}" var="p"><tr><td><c:out value="${p.name}"/></td><td>LKR ${p.price}</td><td>${p.durationHours}h</td><td><span class="status-badge">${p.active ? 'Active' : 'Inactive'}</span></td><td><div class="d-flex gap-1"><a class="btn btn-sm btn-outline-dark" href="${pageContext.request.contextPath}/photographer/manage?editPackageId=${p.packageId}#packageTab">Edit</a><c:if test="${p.active}"><form method="post" action="${pageContext.request.contextPath}/photographer/manage"><input type="hidden" name="action" value="package-delete"><input type="hidden" name="id" value="${p.packageId}"><button class="btn btn-sm btn-outline-danger">Deactivate</button></form></c:if></div></td></tr></c:forEach></tbody></table></div></div>
<div class="tab-pane fade" id="availabilityTab"><div class="panel-card mb-4"><h4>${empty editAvailability ? 'Add availability' : 'Edit availability'}</h4><form method="post" action="${pageContext.request.contextPath}/photographer/manage" class="row g-3"><input type="hidden" name="action" value="${empty editAvailability ? 'availability-add' : 'availability-update'}"><input type="hidden" name="id" value="${empty editAvailability ? 0 : editAvailability.availabilityId}"><div class="col-md-4"><input class="form-control" type="date" name="date" value="${editAvailability.availableDate}" required></div><div class="col-md-3"><input class="form-control" type="time" name="start" value="${editAvailability.startTime}" required></div><div class="col-md-3"><input class="form-control" type="time" name="end" value="${editAvailability.endTime}" required></div><div class="col-md-2 d-grid"><button class="btn btn-dark">${empty editAvailability ? 'Add slot' : 'Update'}</button></div></form></div>
<div class="table-responsive"><table class="table"><thead><tr><th>Date</th><th>Time</th><th>Status</th><th></th></tr></thead><tbody><c:forEach items="${availability}" var="a"><tr><td>${a.availableDate}</td><td>${a.startTime} – ${a.endTime}</td><td>${a.active ? 'Available' : 'Inactive'}</td><td><div class="d-flex gap-1"><a class="btn btn-sm btn-outline-dark" href="${pageContext.request.contextPath}/photographer/manage?editAvailabilityId=${a.availabilityId}#availabilityTab">Edit</a><c:if test="${a.active}"><form method="post" action="${pageContext.request.contextPath}/photographer/manage"><input type="hidden" name="action" value="availability-delete"><input type="hidden" name="id" value="${a.availabilityId}"><button class="btn btn-sm btn-outline-danger">Remove</button></form></c:if></div></td></tr></c:forEach></tbody></table></div></div>
</div></div>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
