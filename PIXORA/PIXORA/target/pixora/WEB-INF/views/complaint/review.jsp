<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<c:set var="pageTitle" value="Leave review"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<div class="container py-5 narrow"><div class="panel-card"><span class="eyebrow">VERIFIED FEEDBACK</span><h2 class="mt-2">Review ${booking.bookingRef}</h2><p class="text-muted">Only customers linked to completed work can publish a photographer review.</p><form method="post" action="${pageContext.request.contextPath}/complaints" class="row g-3"><input type="hidden" name="action" value="review-create"><input type="hidden" name="bookingId" value="${booking.bookingId}"><div class="col-12"><label class="form-label">Rating</label><select class="form-select" name="rating" required><option value="5">5 — Excellent</option><option value="4">4 — Very good</option><option value="3">3 — Good</option><option value="2">2 — Fair</option><option value="1">1 — Poor</option></select></div><div class="col-12"><label class="form-label">Review</label><textarea class="form-control" rows="5" name="comment" required></textarea></div><div class="col-12"><button class="btn btn-warning">Publish review</button></div></form></div></div>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
