<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<c:set var="pageTitle" value="Administration"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<section class="page-hero compact"><div class="container"><span class="eyebrow">SYSTEM ADMINISTRATION</span><h1>Users, approvals & controls</h1><p>Administrative actions are role-protected and auditable.</p></div></section>
<div class="container py-5"><div class="panel-card mb-4"><h4>Pending photographer approvals</h4><div class="table-responsive"><table class="table"><thead><tr><th>Name</th><th>Email</th><th></th></tr></thead><tbody><c:forEach items="${pendingPhotographers}" var="p"><tr><td><c:out value="${p.fullName}"/></td><td><c:out value="${p.email}"/></td><td><form method="post" class="d-flex gap-2"><input type="hidden" name="action" value="approval"><input type="hidden" name="userId" value="${p.userId}"><button class="btn btn-sm btn-success" name="status" value="APPROVED">Approve</button><button class="btn btn-sm btn-outline-danger" name="status" value="REJECTED">Reject</button></form></td></tr></c:forEach><c:if test="${empty pendingPhotographers}"><tr><td colspan="3"><div class="empty-state">No pending profiles.</div></td></tr></c:if></tbody></table></div></div>
<div class="panel-card"><h4>All users</h4><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Name</th><th>Role</th><th>Email</th><th>Status</th><th>Action</th></tr></thead><tbody><c:forEach items="${users}" var="u"><tr><td><c:out value="${u.fullName}"/></td><td>${u.roleCode}</td><td><c:out value="${u.email}"/></td><td><span class="status-badge">${u.status}</span></td><td><c:if test="${u.userId != sessionScope.authUser.userId}"><form method="post" class="d-flex gap-1"><input type="hidden" name="action" value="status"><input type="hidden" name="userId" value="${u.userId}"><button class="btn btn-sm btn-outline-danger" name="status" value="SUSPENDED">Suspend</button><button class="btn btn-sm btn-outline-success" name="status" value="ACTIVE">Activate</button></form></c:if></td></tr></c:forEach></tbody></table></div></div></div>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
