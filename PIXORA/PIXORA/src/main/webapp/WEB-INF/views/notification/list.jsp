<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<c:set var="pageTitle" value="Notifications"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<div class="container py-5 narrow"><div class="d-flex justify-content-between align-items-center mb-4"><div><span class="eyebrow">INBOX</span><h1>Notifications</h1></div><form method="post"><input type="hidden" name="mode" value="all"><button class="btn btn-outline-dark">Mark all read</button></form></div>
<div class="panel-card"><c:forEach items="${notifications}" var="n"><div class="notification-row ${n.read ? '' : 'unread'}"><div><strong><c:out value="${n.title}"/></strong><p class="mb-1"><c:out value="${n.message}"/></p><small>${n.createdAt}</small></div><div class="d-flex gap-2"><c:if test="${not empty n.linkUrl}"><a class="btn btn-sm btn-outline-dark" href="${pageContext.request.contextPath}${n.linkUrl}">Open</a></c:if><c:if test="${!n.read}"><form method="post"><input type="hidden" name="id" value="${n.notificationId}"><button class="btn btn-sm btn-light">Mark read</button></form></c:if></div></div></c:forEach><c:if test="${empty notifications}"><div class="empty-state">No notifications.</div></c:if></div></div>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
